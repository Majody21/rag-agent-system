# Copy this file to `.env` and fill in your keys. Never commit `.env`.

# LLM: Anthropic Claude  (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Embeddings: Google Gemini embeddings  (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=AIzaSy...

# Optional overrides (defaults in config.py)
# AGENT_MODEL=claude-opus-5
# EMBED_MODEL=models/gemini-embedding-001
# CHROMA_PERSIST_DIR=./chroma_db

# AWS OpenSearch Serverless backend (optional; also: pip install -r requirements-aws.txt)
# AWS credentials come from `aws configure` or an IAM role, never from this file.
# VECTOR_BACKEND=opensearch
# OPENSEARCH_ENDPOINT=https://<collection-id>.us-east-1.aoss.amazonaws.com
# OPENSEARCH_INDEX=enterprise-knowledge
# AWS_REGION=us-east-1
